# Optional file for deployment/scripts/update-duckdns.sh.
# Copy to /etc/fileaway/duckdns.env, edit, then:
#   chown root:root /etc/fileaway/duckdns.env
#   chmod 0600 /etc/fileaway/duckdns.env
#
# The domain is the subdomain only, without ".duckdns.org".
DUCKDNS_DOMAIN=your-subdomain
DUCKDNS_TOKEN=replace-with-your-duckdns-token
