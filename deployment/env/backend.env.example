# Copy to /etc/fileaway/backend.env, then edit every value.
# Permissions: root:fileaway, mode 0640. Never commit the real file.
#
# Absolute path: four slashes after sqlite: means /var/lib/...
DATABASE_URL=sqlite:////var/lib/fileaway/fileaway.db
UPLOAD_DIR=/var/lib/fileaway/uploads

# Public backend origin. No trailing slash.
PUBLIC_BASE_URL=https://your-subdomain.duckdns.org

# Comma-separated exact browser origins. No wildcard.
# Local development can be added temporarily:
#   http://localhost:5173,http://127.0.0.1:5173,https://your-project.vercel.app
CORS_ORIGINS=https://your-project.vercel.app

TZ=UTC
