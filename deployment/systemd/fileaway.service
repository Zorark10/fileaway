[Unit]
Description=FileAway FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fileaway
Group=fileaway
WorkingDirectory=/opt/fileaway
EnvironmentFile=/etc/fileaway/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# One worker is required: the in-process cleanup scheduler must not run
# concurrently in multiple workers.
ExecStart=/opt/fileaway/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fileaway
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
