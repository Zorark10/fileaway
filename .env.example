# Local development defaults. Copy to .env and adjust as needed.
DATABASE_URL=sqlite:///./fileaway.db
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage: "local" keeps uploads in UPLOAD_DIR; "b2" uses Backblaze B2.
STORAGE_BACKEND=local
B2_ENDPOINT_URL=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
B2_UPLOAD_PREFIX=uploads/

# Required when STORAGE_BACKEND=b2. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
UPLOAD_SIGNING_SECRET=
CLEANUP_SECRET=

# Timing defaults (seconds unless noted).
SHARE_EXPIRY_HOURS=24
CLEANUP_INTERVAL_HOURS=1
B2_PRESIGN_UPLOAD_SECONDS=1800
B2_PRESIGN_DOWNLOAD_SECONDS=300
UPLOAD_TOKEN_TTL_SECONDS=1800
ORPHAN_GRACE_SECONDS=3600
CLEANUP_BATCH_SIZE=200

# Optional: tests use a temporary SQLite database when this is empty.
# TEST_DATABASE_URL=sqlite:///./test_fileaway.db

# Production database example (Supabase session pooler, IPv4):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
